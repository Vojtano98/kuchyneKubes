---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import Inquiry from '../components/Inquiry.astro';
import { folder } from '../lib/images';
const cover = folder('kuchyne')[4];
---
<Base title="Galerie realizací – kuchyně a nábytek na míru" description="Galerie hotových realizací truhlářství David Kubeš: kuchyně, ložnice, chodby, koupelny, dětské a obývací pokoje na míru." image={cover} transparentHeader>
  <PageHero eyebrow="Realizace" title="Galerie realizací" lead="Hotové realizace u zákazníků – kuchyně, ložnice, chodby, koupelny, dětské i obývací pokoje na míru." image={cover} />
  <Gallery />
  <Inquiry />
</Base>

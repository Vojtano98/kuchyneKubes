---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';
const imgs = folder('sluzby');
const services = categories.filter((c) => c.service).map((c, i) => ({ ...c, img: imgs[i], count: folder(c.slug).length }));
---
<section class="section section--dark services" id="sluzby">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Služby</p>
        <h2 data-reveal>Služby, které poskytujeme</h2>
      </div>
      <p class="lead" data-reveal>Naši zkušení truhláři pracují s maximální precizností, aby vytvořili nábytek, který plně vyhovuje vašim požadavkům.</p>
    </div>

    <div class="tabs" data-reveal>
      <div class="tabs__list" role="tablist" aria-label="Vyberte službu">
        {services.map((s, i) => (
          <button type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
            {s.name}
          </button>
        ))}
      </div>
    </div>

    <div class="panels">
      {services.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0} data-panel>
          <div class="panel__img">
            <Image src={s.img!} alt={`${s.name} – nábytek na míru`} widths={[600, 900, 1300]} sizes="(max-width: 900px) 92vw, 640px" />
          </div>
          <div class="panel__copy">
            <span class="panel__count">{s.count} fotografií v galerii</span>
            <h3>{s.service!.title}</h3>
            {s.service!.paragraphs.map((p) => <p>{p}</p>)}
            <a class="btn" href={`/realizace/#${s.slug}`}>Prohlédnout realizace <Icon name="arrow" /></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tabs { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .tabs__list {
    display: inline-flex; gap: 0.35rem; padding: 0.35rem; border-radius: 999px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
    max-width: 100%; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity;
  }
  .tabs__list::-webkit-scrollbar { display: none; }
  .tabs__list button {
    flex: none; scroll-snap-align: center; font: inherit; font-size: 0.95rem; font-weight: 400;
    color: #c9bfb0; background: transparent; border: 0; border-radius: 999px;
    padding: 0.75rem 1.35rem; cursor: pointer; white-space: nowrap;
    transition: background 0.3s, color 0.3s;
  }
  .tabs__list button:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .tabs__list button[aria-selected='true'] { background: var(--gold-fill); color: var(--ink); font-weight: 500; }

  .panel { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.75rem, 4.5vw, 4rem); align-items: center; animation: panel-in 0.7s var(--ease); }
  .panel__img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 3; background: rgba(255,255,255,0.06); }
  .panel__img img { width: 100%; height: 100%; object-fit: cover; }
  .panel__count { display: block; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-light); margin-bottom: 1rem; }
  .panel__copy h3 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin-bottom: 0.8em; color: #fff; }
  .panel__copy p { color: #cfc6b8; }
  .panel__copy p:last-of-type { margin-bottom: 1.5rem; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(12px); } }

  @media (max-width: 900px) {
    .panel { grid-template-columns: 1fr; }
    .panel__img { aspect-ratio: 16 / 11; }
  }
  @media (max-width: 640px) {
    .tabs__list { display: grid; grid-template-columns: 1fr 1fr; border-radius: 20px; width: 100%; }
    .tabs__list button { border-radius: 14px; padding: 0.7rem 0.6rem; font-size: 0.9rem; }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const list = tabs[0]?.parentElement;
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
      panels[j].hidden = i !== j;
    });
    // keep the active tab visible inside the horizontal list without scrolling the page
    if (list) {
      const t = tabs[i];
      list.scrollTo({ left: t.offsetLeft - (list.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
    if (focus) tabs[i].focus({ preventScroll: true });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
    });
  });
</script>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';
// One modern, sharp realization per category (index in its folder)
const photo: Record<string, number> = { kuchyne: 195, loznice: 16, chodby: 16, koupelny: 7, 'detske-pokoje': 0, 'obyvaci-pokoje': 3 };
const services = categories.filter((c) => c.service).map((c) => ({ ...c, img: folder(c.slug)[photo[c.slug] ?? 0], count: folder(c.slug).length }));
---
<section class="section section--dark services" id="sluzby">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Služby</p>
        <h2 data-reveal>Služby, které poskytujeme</h2>
      </div>
      <p class="lead" data-reveal>Naši zkušení truhláři pracují s maximální precizností, aby vytvořili nábytek, který plně vyhovuje vašim požadavkům.</p>
    </div>

    <div class="tabs" data-reveal>
      <p class="tabs__hint" id="tabs-hint">Vyberte, co vás zajímá</p>
      <div class="tabs__list" role="tablist" aria-labelledby="tabs-hint">
        {services.map((s, i) => (
          <button type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
            <span class="tabs__name">{s.name}</span>
            <span class="tabs__count" aria-label={`${s.count} fotografií`}>{s.count}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="panels">
      {services.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0} data-panel>
          <a class="panel__img" href={`/realizace/#${s.slug}`}>
            <Image src={s.img!} alt={`${s.name} – nábytek na míru`} widths={[600, 900, 1300]} sizes="(max-width: 900px) 92vw, 640px" />
            <span class="panel__more">Zobrazit {s.count} fotografií <Icon name="arrow" size={16} /></span>
          </a>
          <div class="panel__copy">
            <h3>{s.service!.title}</h3>
            {s.service!.paragraphs.map((p) => <p>{p}</p>)}
            <a class="btn" href={`/realizace/#${s.slug}`}>Prohlédnout realizace <Icon name="arrow" /></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tabs { margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem); }
  .tabs__hint { margin: 0 0 0.9rem; font-size: 0.82rem; color: #a99f90; }
  /* Selectable chips: bordered, clearly clickable, the active one filled */
  .tabs__list { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tabs__list button {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 0.9rem;
    font: inherit; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap;
    color: #d9d1c4; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.18); border-radius: var(--radius-btn);
    padding: 0.85rem 1.1rem; min-height: 48px; cursor: pointer; transition: color 0.3s, background 0.3s, border-color 0.3s;
  }
  .tabs__count { font-size: 0.74rem; letter-spacing: 0.04em; color: #8f8578; font-variant-numeric: tabular-nums; transition: color 0.3s; }
  .tabs__list button:hover { color: #fff; border-color: rgba(255,255,255,0.45); }
  .tabs__list button[aria-selected='true'] { color: #fff; background: var(--gold-fill); border-color: var(--gold-fill); }
  .tabs__list button[aria-selected='true'] .tabs__count { color: rgba(255,255,255,0.85); }

  .panel { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.75rem, 4.5vw, 4rem); align-items: center; animation: panel-in 0.7s var(--ease); }
  .panel__img { position: relative; display: block; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 3; background: rgba(255,255,255,0.06); box-shadow: 0 0 0 1px rgba(227, 199, 143, 0.18), 0 30px 60px -30px rgba(0, 0, 0, 0.7); }
  .panel__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .panel__img:hover img { transform: scale(1.03); }
  .panel__more { position: absolute; right: 0.9rem; bottom: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.9rem; background: rgba(15, 12, 9, 0.72); backdrop-filter: blur(6px); color: #fff; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; border-radius: var(--radius-btn); }
  .panel__more :global(svg) { color: var(--gold-light); }
  .panel__copy h3 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin-bottom: 0.8em; color: #fff; }
  .panel__copy p { color: #cfc6b8; }
  .panel__copy p:last-of-type { margin-bottom: 1.5rem; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(12px); } }

  @media (max-width: 900px) {
    .panel { grid-template-columns: 1fr; }
    .panel__img { aspect-ratio: 16 / 11; }
  }
  @media (max-width: 640px) {
    .tabs__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .tabs__list button { padding: 0.75rem 0.7rem; font-size: 0.72rem; letter-spacing: 0.06em; gap: 0.4rem; }
  }
  /* Narrowest phones: let long names wrap instead of pushing the grid wider than the screen */
  @media (max-width: 360px) { .tabs__list { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .tabs__list button { white-space: normal; text-align: left; line-height: 1.3; min-width: 0; } }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const list = tabs[0]?.parentElement;
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
      panels[j].hidden = i !== j;
    });
    // keep the active tab visible inside the horizontal list without scrolling the page
    if (list) {
      const t = tabs[i];
      list.scrollTo({ left: t.offsetLeft - (list.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
    if (focus) tabs[i].focus({ preventScroll: true });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
    });
  });
</script>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { folder } from '../lib/images';
import { site } from '../data/site';
const [prodejna] = folder('onas');
const kuchyne = folder('kuchyne');
const kitchen = kuchyne[0];
// Two more realizations peek out behind the main photo as a card stack
const stack = [kuchyne[88], kuchyne[185]];
---
<section class="section about about--compact" id="onas">
  <div class="container about__grid">
    <div class="about__media" data-reveal>
      <div class="about__stack">
        {stack.map((img, i) => (
          <div class:list={['about__img', 'about__card', `about__card--${i + 1}`]} aria-hidden="true">
            <Image src={img} alt="" widths={[480, 800]} sizes="(max-width: 900px) 1px, 520px" loading="lazy" />
          </div>
        ))}
        <div class="about__img about__img--main">
          <Image src={kitchen} alt="Kuchyň na míru od truhlářství David Kubeš" widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 560px" />
        </div>
      </div>
      <figure class="about__img about__img--small">
        <Image src={prodejna} alt="Prodejna a vzorkovna Kuchyně Nábytek Kubeš ve Svinném u Chotěboře" widths={[300, 470]} sizes="240px" />
        <figcaption>Prodejna a vzorkovna, Svinný 82</figcaption>
      </figure>
    </div>
    <div class="about__text">
      <p class="eyebrow" data-reveal>O nás</p>
      <h2 data-reveal>Kuchyně a nábytek na míru z vlastní dílny</h2>
      <p data-reveal>Jsme Truhlářství David Kubeš s dílnou a vzorkovým kuchyňským studiem ve Svinném u Chotěboře. Naši truhláři jsou vyučení v oboru a pracují s kvalitními materiály a doplňky. Zakázky nenadhodnocujeme – nejlepší reklamou jsou nám spokojení zákazníci.</p>
      <ul class="about__points" data-reveal>
        <li><Icon name="check" size={18} /> Vyučení truhláři</li>
        <li><Icon name="check" size={18} /> Férové ceny bez nadhodnocení</li>
        <li><Icon name="check" size={18} /> Kvalitní materiály a doplňky</li>
        <li><Icon name="check" size={18} /> Vzorkové studio u Chotěboře</li>
      </ul>
      <a class="link-arrow about__link" href="#kontakt" data-reveal>Přijďte se podívat do studia <Icon name="arrow" size={16} /></a>
    </div>
  </div>
  <div class="container">
    <div class="contact-strip" data-reveal>
      <div>
        <p class="contact-strip__title">Nábytek na míru přesně podle vašich představ</p>
        <p class="contact-strip__text">Zavolejte nám, rádi se vám budeme věnovat.</p>
      </div>
      <div class="contact-strip__actions">
        <a class="btn" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
        <a class="btn btn--outline" href="#poptavka">Nezávazná poptávka</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .about__media { position: relative; padding: 0 0 3rem 0; }
  .about__img { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  /* Card stack: two photos peek out behind the main one and fan open on hover */
  .about__stack { position: relative; width: 86%; aspect-ratio: 4 / 5; }
  .about__img--main, .about__card { position: absolute; inset: 0; transition: transform 0.8s var(--ease), box-shadow 0.8s var(--ease); }
  .about__img--main { z-index: 2; }
  .about__img--main img, .about__card img { width: 100%; height: 100%; object-fit: cover; }
  .about__card { box-shadow: 0 18px 40px -26px rgba(21, 18, 14, 0.45); }
  .about__card img { filter: saturate(0.9) brightness(0.96); }
  .about__card--1 { z-index: 1; transform: rotate(-4deg) translate(-2.5%, 1.5%); }
  .about__card--2 { z-index: 0; transform: rotate(3.5deg) translate(3%, -2%); }
  .about__img--small { transition: transform 0.8s var(--ease); }
  @media (hover: hover) {
    .about__media:hover .about__img--main { transform: rotate(-0.8deg) translateY(-6px); box-shadow: 0 34px 60px -30px rgba(21, 18, 14, 0.5); }
    .about__media:hover .about__card--1 { transform: rotate(-9deg) translate(-9%, 3%); }
    .about__media:hover .about__card--2 { transform: rotate(8deg) translate(9%, -4%); }
    .about__media:hover .about__img--small { transform: translate(3%, 3%) rotate(1.5deg); }
  }
  .about__img--small { position: absolute; z-index: 3; right: 0; bottom: 0; width: 46%; background: var(--paper); padding: 0.6rem 0.6rem 0.2rem; border-radius: var(--radius); }
  .about__img--small img { border-radius: calc(var(--radius) - 4px); aspect-ratio: 470 / 550; object-fit: cover; width: 100%; }
  .about__img--small figcaption { font-size: 0.78rem; color: var(--muted); padding: 0.5rem 0.2rem; }
  .about__points { list-style: none; padding: 1.75rem 0 0; border-top: 1px solid var(--line); margin: 1.5rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.5rem; }
  .about__points li { display: flex; gap: 0.6rem; align-items: center; font-weight: 500; color: var(--ink); }
  .about__points :global(svg) { color: var(--gold); flex: none; width: 18px; height: 18px; }
  .contact-strip { margin-top: clamp(2.5rem, 5vw, 3.5rem); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; flex-wrap: wrap; padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2.5rem); background: var(--cream); border-radius: var(--radius-lg); border-left: 3px solid var(--gold); }
  .contact-strip__title { font-size: clamp(1.35rem, 2.3vw, 1.85rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.25; color: var(--ink); margin: 0 0 0.3rem; }
  .contact-strip__text { margin: 0; color: var(--muted); }
  .contact-strip__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  /* Phones: both buttons side by side, filling the row */
  @media (max-width: 560px) {
    .contact-strip { padding: 1.4rem 1.1rem 1.4rem 1.25rem; }
    .contact-strip__actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .contact-strip__actions .btn { min-width: 0; padding: 0.7rem 0.5rem; font-size: 0.66rem; letter-spacing: 0.08em; gap: 0.4rem; white-space: normal; text-align: center; }
    .contact-strip__actions .btn :global(svg) { width: 1.2em; height: 1.2em; }
  }
  @media (max-width: 360px) {
    .contact-strip__actions .btn :global(svg) { display: none; }
  }
  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__media { max-width: 560px; }
  }
  .about__link { margin-top: 1.5rem; }
  /* Small screens: the text comes first, one photo only */
  @media (max-width: 900px) {
    .about--compact .about__text { order: -1; }
    .about--compact .about__media { max-width: none; padding: 0; }
    .about--compact .about__stack { width: 100%; aspect-ratio: 16 / 10; }
    .about--compact .about__card { display: none; }
    .about--compact .about__img--small { display: none; }
    .about--compact .about__points { gap: 0.7rem 1rem; font-size: 0.95rem; }
    .about--compact .about__points li { align-items: flex-start; }
    .about--compact .about__points :global(svg) { margin-top: 0.3em; }
  }
</style>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { folder } from '../lib/images';
import { site } from '../data/site';
const [prodejna] = folder('onas');
const kitchen = folder('kuchyne')[0];
---
<section class="section about" id="onas">
  <div class="container about__grid">
    <div class="about__media" data-reveal>
      <div class="about__img about__img--main">
        <Image src={kitchen} alt="Kuchyň na míru od truhlářství David Kubeš" widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 560px" />
      </div>
      <figure class="about__img about__img--small">
        <Image src={prodejna} alt="Prodejna a vzorkovna Kuchyně Nábytek Kubeš ve Svinném u Chotěboře" widths={[300, 470]} sizes="240px" />
        <figcaption>Prodejna a vzorkovna, Svinný 82</figcaption>
      </figure>
    </div>
    <div class="about__text">
      <p class="eyebrow" data-reveal>O nás</p>
      <h2 data-reveal>Kvalitně odvedená práce je naší prioritou</h2>
      <p data-reveal>Naši pracovníci jsou vyučeni v oboru a dbá se na to, aby se jejich kvalifikace neustále zvyšovala. Jsou to skuteční profesionálové ve svém oboru. Precizně odvedená kvalitní práce, kterou za sebou nechávají, je toho důkazem. K dobré práci samozřejmě patří také zásady jako je <strong>nenadhodnocování zakázek</strong>, práce s kvalitními materiály a doplňky.</p>
      <p data-reveal>Na prvním místě jsou poctivé výrobky, které jsou samy o sobě vítanou reklamou a doporučením. Prioritou je samozřejmě spokojenost zákazníka – o naší kvalitě se nyní můžete přesvědčit osobně v našem <strong>vzorkovém kuchyňském studiu</strong>.</p>
      <ul class="about__points" data-reveal>
        <li><Icon name="check" size={18} /> Vyučení truhláři</li>
        <li><Icon name="check" size={18} /> Nenadhodnocené zakázky</li>
        <li><Icon name="check" size={18} /> Kvalitní materiály a doplňky</li>
        <li><Icon name="check" size={18} /> Vzorkové kuchyňské studio</li>
      </ul>
    </div>
  </div>
</section>

<section class="callband" aria-label="Zavolejte nám">
  <div class="container callband__inner" data-reveal>
    <p class="callband__title">Nábytek na míru přesně podle vašich představ</p>
    <div class="callband__cta">
      <span>Zavolejte nám, rádi se vám budeme věnovat.</span>
      <a class="btn" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .about__media { position: relative; padding: 0 0 4rem 0; }
  .about__img { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .about__img--main { aspect-ratio: 4 / 5; width: 86%; }
  .about__img--main img { width: 100%; height: 100%; object-fit: cover; }
  .about__img--small { position: absolute; right: 0; bottom: 0; width: 46%; background: var(--paper); padding: 0.6rem 0.6rem 0.2rem; border-radius: var(--radius); }
  .about__img--small img { border-radius: calc(var(--radius) - 4px); aspect-ratio: 470 / 550; object-fit: cover; width: 100%; }
  .about__img--small figcaption { font-size: 0.78rem; color: var(--muted); padding: 0.5rem 0.2rem; }
  .about__points { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.5rem; }
  .about__points li { display: flex; gap: 0.6rem; align-items: center; font-weight: 400; }
  .about__points svg { color: var(--gold); flex: none; }
  .callband { background: var(--gold); color: #fff; }
  .callband__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: clamp(2.5rem, 5vw, 3.5rem); flex-wrap: wrap; }
  .callband__title { font-size: clamp(1.4rem, 2.6vw, 2.1rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; margin: 0; max-width: 22ch; }
  .callband__cta { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .callband .btn { --bg: var(--ink); border-color: var(--ink); font-size: 1.05rem; }
  .callband .btn:hover { --bg: #000; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.5); }
  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__media { max-width: 560px; }
  }
  @media (max-width: 480px) { .about__points { grid-template-columns: 1fr; } }
</style>

---
import { Image } from 'astro:assets';
interface Props { title: string; eyebrow?: string; lead?: string; image?: ImageMetadata }
const { title, eyebrow, lead, image } = Astro.props;
---
<section class="page-hero">
  {image && <div class="page-hero__bg"><Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" priority quality={65} /></div>}
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { branches, site } from '../data/site';
import { folder } from '../lib/images';
const photos: Record<string, ImageMetadata | undefined> = { chotebor: folder('onas')[0] };
---
<section class="section branches" id="pobocky">
  <span id="kontakt" class="anchor" aria-hidden="true"></span>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Kontakty</p>
      <h2 data-reveal>Naše pobočky a kontakt</h2>
      <p class="lead" data-reveal>Přijďte se podívat do našeho vzorkového kuchyňského studia, nebo si domluvte prohlídku kompletně vybaveného vzorového bytu.</p>
    </div>
    <div class="branches__grid">
      {branches.map((b, i) => (
        <article class="branch" data-reveal style={`--delay:${i * 0.1}s`}>
          <div class:list={['branch__map', { 'branch__map--photo': photos[b.id] }]} data-map={b.map}>
            {photos[b.id] && <Image src={photos[b.id]!} alt={b.title} widths={[470]} sizes="(max-width: 860px) 92vw, 600px" />}
            {!photos[b.id] && <span class="branch__pin" aria-hidden="true"><Icon name="pin" size={30} /></span>}
            <button type="button" class="branch__mapbtn" data-map-load><Icon name="pin" size={16} /> Zobrazit mapu</button>
          </div>
          <div class="branch__body">
            <h3>{b.title}</h3>
            <p class="branch__addr"><Icon name="pin" size={18} /> <span>{b.street}<br />{b.city}</span></p>
            {b.hours.length > 0 && (
              <div class="branch__hours">
                <p class="branch__label"><Icon name="clock" size={18} /> Otevírací doba</p>
                <dl>
                  {b.hours.map(([d, h]) => (<><dt>{d}</dt><dd>{h}</dd></>))}
                </dl>
              </div>
            )}
            {b.note && <p class="branch__label"><Icon name="clock" size={18} /> {b.note}</p>}
            <div class="branch__actions">
              <a class="link-arrow" href={b.mapLink} target="_blank" rel="noopener">Navigovat <Icon name="arrow" size={16} /></a>
              <a class="link-arrow" href={site.phoneHref}>Domluvit návštěvu <Icon name="arrow" size={16} /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="branches__billing" data-reveal>
      <h3>Fakturační adresa a sídlo společnosti</h3>
      <p>{site.billing}<br />IČ: {site.ico} &nbsp;·&nbsp; DIČ: {site.dic}</p>
    </div>
  </div>
</section>

<style>
  .branches { position: relative; }
  .anchor { position: absolute; top: 0; }
  .branches__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); }
  .branch { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: #fff; display: flex; flex-direction: column; }
  .branch h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); margin-bottom: 1rem; }
  .branch__map { aspect-ratio: 16 / 9; background: var(--cream); position: relative; display: grid; place-items: center; overflow: hidden; }
  .branch__map img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  .branch__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .branch__pin { width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--gold); box-shadow: 0 12px 30px -16px rgba(21,18,14,0.4); }
  .branch__pin svg { margin: 0; }
  .branch__mapbtn { position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.45rem; font: inherit; font-size: 0.85rem; font-weight: 500; color: var(--ink); background: #fff; border: 0; border-radius: 999px; padding: 0.6rem 1.05rem; cursor: pointer; box-shadow: 0 8px 24px -12px rgba(0,0,0,0.45); transition: background 0.3s, color 0.3s; }
  .branch__mapbtn:hover { background: var(--ink); color: #fff; }
  .branch__mapbtn svg { margin: 0; }
  .branch__body { padding: clamp(1.4rem, 3vw, 2.2rem); flex: 1; display: flex; flex-direction: column; }
  .branch__addr, .branch__label { display: flex; gap: 0.6rem; align-items: flex-start; font-weight: 400; }
  .branch svg { color: var(--gold); flex: none; margin-top: 0.3em; }
  .branch__hours dl { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1.5rem; margin: 0 0 1rem 1.75rem; font-size: 0.95rem; }
  .branch__hours dt { color: var(--muted); }
  .branch__hours dd { margin: 0; }
  .branch__actions { margin-top: auto; padding-top: 1rem; display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .branches__billing { margin-top: clamp(1rem, 3vw, 2rem); padding: 1.5rem clamp(1.4rem, 3vw, 2.2rem); background: var(--cream); border-radius: var(--radius); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; align-items: baseline; }
  .branches__billing h3 { font-size: 1rem; margin: 0; }
  .branches__billing p { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .branches__grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.map!;
      f.title = 'Mapa';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>

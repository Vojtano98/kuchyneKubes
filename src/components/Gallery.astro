---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';

interface Props { only?: string[]; filters?: boolean; headings?: boolean; pageSize?: number }
// pageSize: photos shown per category before "Zobrazit další" (long categories would otherwise be 25 phone screens)
const { only, filters = true, headings = true, pageSize = 24 } = Astro.props;
// The sale kitchen has its own page; it is not a customer realization
const notRealizations = ['kuchyn-na-prodej'];

// Hand-picked photos first, then the rest; small old photos (under 1000 px wide) go last because they look soft
const orderFeatured = <T extends { width: number }>(list: T[], featured: number[] = []) => {
  const first = featured.map((i) => list[i]).filter(Boolean);
  const rest = list.filter((x) => !first.includes(x));
  return [...first, ...rest.filter((x) => x.width >= 1000), ...rest.filter((x) => x.width < 1000)];
};
const groups = await Promise.all(
  categories
    .filter((c) => (only ? only.includes(c.slug) : !notRealizations.includes(c.slug)))
    .map(async (c) => ({
      ...c,
      items: await Promise.all(
        orderFeatured(folder(c.slug), c.featured).map(async (img) => ({ img, large: await getImage({ src: img, width: Math.min(img.width, 1800), format: 'webp', quality: 80 }) })),
      ),
    })),
);
const total = groups.reduce((n, g) => n + g.items.length, 0);
---
{filters && (
  <div class="filters" data-filters>
    <div class="container">
      <div class="filters__scroll" role="toolbar" aria-label="Filtrovat realizace">
        {groups.map((g, i) => <button type="button" data-filter={g.slug} aria-pressed={i === 0 ? 'true' : 'false'}>{g.name} <span>{g.items.length}</span></button>)}
        <button type="button" data-filter="vse" aria-pressed="false">Vše <span>{total}</span></button>
      </div>
    </div>
  </div>
)}

<div class="container gallery" data-gallery>
  {groups.map((g) => (
    <section class="gallery__group" id={g.slug} data-group={g.slug} aria-labelledby={`h-${g.slug}`}>
      <div class:list={['gallery__head', { 'visually-hidden': !headings }]}>
        <h2 id={`h-${g.slug}`}>{g.name}</h2>
        <span>{g.items.length} fotografií</span>
      </div>
      <div class="gallery__grid">
        {g.items.map(({ img, large }, i) => (
          <a class="gallery__item" href={large.src} hidden={i >= pageSize} data-lb data-w={large.attributes.width} data-h={large.attributes.height} data-caption={g.name}>
            <Image src={img} alt={`${g.name} – realizace ${i + 1}`} widths={[360, 560, 800]} sizes="(max-width: 560px) 46vw, (max-width: 1000px) 31vw, 300px" quality={70} />
            <span class="gallery__zoom" aria-hidden="true"><Icon name="expand" size={18} /></span>
          </a>
        ))}
      </div>
      {g.items.length > pageSize && (
        <div class="gallery__more">
          <button type="button" class="btn btn--outline" data-more data-step={pageSize}>
            Zobrazit další fotografie <span data-more-count>({g.items.length - pageSize})</span>
          </button>
          <p class="gallery__shown" aria-live="polite" data-shown>Zobrazeno {pageSize} z {g.items.length}</p>
        </div>
      )}
    </section>
  ))}
</div>

<dialog class="lb" data-lightbox aria-label="Prohlížeč fotografií">
  <div class="lb__stage" data-stage>
    <img data-lb-img alt="" />
    <div class="lb__spinner" aria-hidden="true"></div>
  </div>
  <div class="lb__bar">
    <span data-lb-caption></span>
    <span data-lb-count></span>
  </div>
  <button class="lb__btn lb__close" type="button" data-lb-close aria-label="Zavřít"><Icon name="close" size={22} /></button>
  <button class="lb__btn lb__prev" type="button" data-lb-prev aria-label="Předchozí fotografie"><Icon name="left" size={26} /></button>
  <button class="lb__btn lb__next" type="button" data-lb-next aria-label="Další fotografie"><Icon name="right" size={26} /></button>
</dialog>

<style>
  .filters { position: sticky; top: 0; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--line); transition: top 0.5s var(--ease); }
  .filters__scroll { display: flex; gap: 0.5rem; overflow-x: auto; padding: 0.9rem 0; scrollbar-width: none; }
  .filters__scroll::-webkit-scrollbar { display: none; }
  .filters button { flex: none; font: inherit; font-size: 0.9rem; font-weight: 400; padding: 0.55rem 1.1rem; border-radius: var(--radius-btn); border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .filters button span { color: var(--muted); font-size: 0.78rem; margin-left: 0.2rem; }
  .filters button:hover { border-color: var(--gold-fill); background: var(--gold-tint); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: #fff; border-color: var(--ink); box-shadow: inset 0 -2px 0 var(--gold-fill); }
  .filters button[aria-pressed='true'] span { color: var(--gold-soft); }

  .gallery { padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(3rem, 6vw, 4.5rem); }
  .gallery__group { scroll-margin-top: calc(var(--header-h-compact) + 80px); }
  .gallery__group:not([hidden]) ~ .gallery__group:not([hidden]) { margin-top: clamp(2.25rem, 4vw, 3.25rem); }
  .gallery__group[hidden] { display: none; }
  .gallery__head { position: relative; display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .gallery__head::after { content: ''; position: absolute; left: 0; bottom: -1px; width: min(220px, 40%); height: 1px; background: linear-gradient(90deg, var(--gold-fill), rgba(193, 144, 49, 0)); }
  .gallery__head h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .gallery__head span { color: var(--gold); font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; }
  /* Row-major grid of uniform 4:3 tiles: the hand-picked photos (featured) fill the first rows; the lightbox shows each photo uncropped */
  .gallery__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: clamp(0.6rem, 1.2vw, 1rem); }
  .gallery__item { display: block; position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--sand); }
  .gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease), filter 0.5s; }
  .gallery__item::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(227, 199, 143, 0); transition: box-shadow 0.5s var(--ease); pointer-events: none; }
  .gallery__item:hover::after { box-shadow: inset 0 0 0 1px rgba(227, 199, 143, 0.85); }
  .gallery__item:hover img { transform: scale(1.04); }
  .gallery__zoom { position: absolute; right: 0.7rem; top: 0.7rem; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.92); color: var(--ink); display: grid; place-items: center; opacity: 0; transform: scale(0.8); transition: opacity 0.4s var(--ease), transform 0.4s var(--ease); }
  .gallery__item:hover .gallery__zoom { opacity: 1; transform: none; color: var(--gold); }
  .gallery__more { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: clamp(1.25rem, 3vw, 2rem); }
  .gallery__shown { margin: 0; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 560px) { .gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(12, 10, 8, 0.97); color: #fff; overscroll-behavior: contain; }
  .lb::backdrop { background: rgba(12, 10, 8, 0.9); }
  .lb[open] { display: grid; grid-template-rows: 1fr auto; animation: lb-in 0.35s var(--ease); }
  @keyframes lb-in { from { opacity: 0; } }
  .lb__stage { position: relative; display: grid; place-items: center; padding: clamp(0.5rem, 3vw, 2.5rem) clamp(0.5rem, 7vw, 6rem) 0; min-height: 0; touch-action: pan-y pinch-zoom; }
  .lb__stage img { max-width: 100%; max-height: calc(100dvh - 6.5rem); width: auto; height: auto; object-fit: contain; border-radius: 6px; transition: opacity 0.3s, transform 0.4s var(--ease); user-select: none; -webkit-user-drag: none; }
  .lb__stage img.is-loading { opacity: 0; }
  .lb__spinner { position: absolute; width: 36px; height: 36px; border: 2px solid rgba(255,255,255,0.15); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.9s linear infinite; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  .lb__stage:has(img.is-loading) .lb__spinner { opacity: 1; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .lb__bar { display: flex; justify-content: space-between; padding: 1rem clamp(1rem, 4vw, 2rem); font-size: 0.9rem; color: #b9b0a2; }
  .lb__bar [data-lb-caption] { color: #fff; }
  .lb__btn { position: absolute; width: 54px; height: 54px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.06); color: #fff; display: grid; place-items: center; cursor: pointer; transition: background 0.3s, border-color 0.3s; }
  .lb__btn:hover { background: var(--gold-fill); border-color: var(--gold-fill); color: #fff; }
  .lb__close { top: 1rem; right: 1rem; }
  .lb__prev, .lb__next { top: 50%; transform: translateY(-50%); }
  .lb__prev { left: 1rem; }
  .lb__next { right: 1rem; }
  @media (max-width: 700px) { .lb__prev, .lb__next { top: auto; bottom: 3.6rem; transform: none; width: 48px; height: 48px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (root && dialog) {
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let items: HTMLAnchorElement[] = [];
    let index = 0;

    const applyFilter = (slug: string, scroll = false) => {
      const valid = slug === 'vse' || groups.some((g) => g.dataset.group === slug);
      if (!valid) slug = groups[0].dataset.group!;
      groups.forEach((g) => (g.hidden = slug !== 'vse' && g.dataset.group !== slug));
      buttons.forEach((b) => {
        const on = b.dataset.filter === slug;
        b.setAttribute('aria-pressed', String(on));
        if (on) b.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
      if (scroll) scrollToGallery('smooth');
    };
    // Land the first visible heading just below the sticky header + filter bar (same spot for every category)
    const scrollToGallery = (behavior: ScrollBehavior) => {
      const first = groups.find((g) => !g.hidden) ?? root;
      const bar = document.querySelector<HTMLElement>('[data-filters]');
      const offset = bar ? parseFloat(getComputedStyle(bar).top) + bar.offsetHeight : 0;
      const y = first.getBoundingClientRect().top + window.scrollY - offset - 24;
      window.scrollTo({ top: Math.max(0, y), behavior });
    };
    if (buttons.length) {
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const slug = b.dataset.filter!;
          history.replaceState(null, '', slug === groups[0].dataset.group ? location.pathname : `#${slug}`);
          applyFilter(slug, true);
        }),
      );
      const fromHash = () => applyFilter(decodeURIComponent(location.hash.slice(1)) || groups[0].dataset.group!);
      window.addEventListener('hashchange', fromHash);
      fromHash();
      if (location.hash) requestAnimationFrame(() => scrollToGallery('instant'));
    }

    // "Zobrazit další": reveal the next batch of hidden photos in that category
    root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
      const group = btn.closest<HTMLElement>('[data-group]')!;
      const wrap = btn.parentElement!;
      btn.addEventListener('click', () => {
        const all = [...group.querySelectorAll<HTMLElement>('[data-lb]')];
        const rest = all.filter((a) => a.hidden);
        rest.slice(0, Number(btn.dataset.step)).forEach((a) => (a.hidden = false));
        const left = rest.length - Number(btn.dataset.step);
        const shown = all.length - Math.max(left, 0);
        wrap.querySelector('[data-shown]')!.textContent = `Zobrazeno ${shown} z ${all.length}`;
        if (left > 0) btn.querySelector('[data-more-count]')!.textContent = `(${left})`;
        else btn.remove();
      });
    });

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.src = a.href;
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      img.alt = a.querySelector('img')?.alt ?? '';
      caption.textContent = a.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${items.length}`;
      [index + 1, index - 1].forEach((n) => { const p = items[(n + items.length) % items.length]; if (p) new Image().src = p.href; });
    };

    root.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lb]');
      if (!a || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      items = [...root.querySelectorAll<HTMLAnchorElement>('[data-group]:not([hidden]) [data-lb]')];
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      show(items.indexOf(a));
    });
    dialog.addEventListener('close', () => { document.body.style.overflow = ''; img.removeAttribute('src'); });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-stage]')!.addEventListener('click', (e) => { if (e.target === e.currentTarget) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => { if (e.touches.length === 1) x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>

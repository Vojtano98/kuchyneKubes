---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="mbar" data-mbar aria-label="Rychlý kontakt">
  <a class="mbar__btn mbar__btn--call" href={site.phoneHref}><Icon name="phone" size={18} /> Zavolat</a>
  <a class="mbar__btn mbar__btn--cta" href="/#poptavka">Nezávazná poptávka</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar {
      position: fixed; z-index: 45; left: 0; right: 0; bottom: 0;
      display: grid; grid-template-columns: 1fr 1.6fr;
      padding-bottom: env(safe-area-inset-bottom); background: var(--ink);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      transform: translateY(100%); transition: transform 0.45s var(--ease);
    }
    .mbar.is-visible { transform: none; }
    .mbar__btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; height: 54px; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; }
    .mbar__btn--call { color: #fff; }
    .mbar__btn--call :global(svg) { color: var(--gold-light); width: 16px; height: 16px; }
    .mbar__btn--cta { background: var(--gold-fill); color: #fff; }
    :global(.footer) { padding-bottom: calc(5rem + env(safe-area-inset-bottom)) !important; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  if (bar) {
    // Show after the first screen; hide while a form is on screen (it has its own buttons)
    let formsInView = 0;
    const update = () => bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6 && formsInView === 0);
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (formsInView += e.isIntersecting ? 1 : -1));
      formsInView = Math.max(0, formsInView);
      update();
    });
    document.querySelectorAll('[data-form]').forEach((f) => io.observe(f));
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

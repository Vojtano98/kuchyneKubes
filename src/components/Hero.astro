---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { folder } from '../lib/images';

const imgs = folder('hero');
// Slides taken over from the original website (same order, texts and targets).
const slides = [
  { img: imgs[1], title: 'Tvoříme kuchyně na míru vašim představám', link: ['Prohlédnout realizace', '/realizace/'] },
  { img: imgs[2], title: 'Kuchyně propracované do posledního detailu', link: ['Dokončené realizace', '/realizace/'] },
  { img: imgs[3], title: 'Kuchyně i obývací stěny na míru', link: ['Prohlédnout realizace', '/realizace/#obyvaci-pokoje'] },
  { img: imgs[4], title: 'Vystavená kuchyň na prodej za akční cenu', link: ['Prohlédnout zblízka', '/kuchyn-na-prodej/'] },
];
---
<section class="hero" data-hero aria-roledescription="carousel" aria-label="Představení">
  <div class="hero__slides">
    {slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : undefined}>
        <div class="hero__media">
          <Image src={s.img} alt="" widths={[768, 1280, 1920, 2560]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} priority={i === 0} quality={75} />
        </div>
        <div class="container hero__content">
          {i === 0 ? <h1>{s.title}</h1> : <p class="hero__title">{s.title}</p>}
          <a class="hero__link" href={s.link[1]} tabindex={i === 0 ? undefined : -1}>{s.link[0]} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    ))}
  </div>
  <div class="container hero__controls">
    <div class="hero__dots" role="tablist" aria-label="Vybrat snímek">
      {slides.map((s, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Snímek ${i + 1}: ${s.title}`} data-dot={i}>
          <span class="hero__dot-bar"><i></i></span>
        </button>
      ))}
    </div>
    <button type="button" class="hero__pause" data-pause aria-pressed="false" aria-label="Pozastavit prezentaci"><Icon name="pause" size={16} class="i-pause" /><Icon name="play" size={16} class="i-play" /></button>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; max-height: 1100px; color: #fff; background: var(--ink); overflow: hidden; }
  .hero__slides, .hero__slide { position: absolute; inset: 0; }
  .hero__slide { opacity: 0; visibility: hidden; transition: opacity 0.9s var(--ease), visibility 0s 0.9s; display: flex; align-items: flex-end; }
  .hero__slide.is-active { opacity: 1; visibility: visible; transition: opacity 0.9s var(--ease), visibility 0s; z-index: 1; }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.05); transition: transform 5.5s linear; }
  .is-active .hero__media img { transform: scale(1); }
  /* Only a soft strip at the bottom (text) and top (menu) – the photo stays clean */
  .hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(15, 12, 9, 0.5) 0%, rgba(15, 12, 9, 0.18) 24%, rgba(15, 12, 9, 0) 42%), linear-gradient(180deg, rgba(15, 12, 9, 0.3) 0%, rgba(15, 12, 9, 0) 18%); }
  .hero__content { position: relative; padding-bottom: clamp(4.5rem, 9vh, 6.5rem); text-shadow: 0 1px 16px rgba(0, 0, 0, 0.3); }
  .hero h1, .hero__title { font-size: clamp(1.9rem, 3.6vw, 3.1rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.025em; max-width: 19ch; margin: 0 0 1rem; text-wrap: balance; }
  .hero__link { display: inline-flex; align-items: center; gap: 0.5rem; color: #fff; text-decoration: none; font-weight: 500; font-size: 0.98rem; padding-bottom: 0.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.6); transition: border-color 0.3s, gap 0.3s var(--ease); }
  .hero__link:hover { border-color: #fff; gap: 0.8rem; }
  .hero__content > * { opacity: 0; transform: translateY(18px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  .is-active .hero__content > * { opacity: 1; transform: none; }
  .is-active .hero__content > :nth-child(2) { transition-delay: 0.12s; }
  .hero__controls { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(1.5rem, 4vh, 2.25rem); display: flex; justify-content: flex-end; align-items: center; gap: 0.9rem; }
  .hero__dots { display: flex; gap: 0.45rem; }
  .hero__dots button { background: none; border: 0; cursor: pointer; padding: 0.6rem 0; }
  .hero__dot-bar { display: block; width: clamp(22px, 3vw, 36px); height: 2px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .hero__dot-bar i { display: block; height: 100%; width: 100%; background: #fff; transform: scaleX(0); transform-origin: left; }
  [aria-selected='true'] .hero__dot-bar i { animation: hero-progress var(--hero-duration, 7s) linear forwards; }
  .hero.is-paused [aria-selected='true'] .hero__dot-bar i { animation-play-state: paused; transform: scaleX(1); }
  @keyframes hero-progress { to { transform: scaleX(1); } }
  .hero__pause { width: 30px; height: 30px; border-radius: 50%; border: 0; background: transparent; color: rgba(255, 255, 255, 0.8); display: grid; place-items: center; cursor: pointer; transition: color 0.3s, background 0.3s; }
  .hero__pause:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }
  .hero__pause :global(.i-play), .hero__pause[aria-pressed='true'] :global(.i-pause) { display: none; }
  .hero__pause[aria-pressed='true'] :global(.i-play) { display: block; }
  @media (max-width: 760px) {
    .hero { height: 88svh; }
    .hero__content { padding-bottom: 4.25rem; }
    .hero h1, .hero__title { font-size: clamp(1.7rem, 7vw, 2.2rem); }
    .hero__controls { justify-content: flex-start; }
    .hero__media::after { background: linear-gradient(0deg, rgba(15, 12, 9, 0.58) 0%, rgba(15, 12, 9, 0.22) 30%, rgba(15, 12, 9, 0) 50%), linear-gradient(180deg, rgba(15, 12, 9, 0.3) 0%, rgba(15, 12, 9, 0) 18%); }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const DURATION = 4500;
    hero.style.setProperty('--hero-duration', `${DURATION}ms`);
    let current = 0;
    let timer: number | undefined;
    let remaining = DURATION;
    let started = 0;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]')!;
    // Autoplay runs only when nothing holds it: user pause, mouse over, keyboard focus, hidden tab
    const holds = new Set<string>(reduced ? ['user'] : []);

    const tick = () => {
      clearTimeout(timer);
      hero.classList.toggle('is-paused', holds.size > 0);
      if (holds.size > 0) return;
      started = Date.now();
      timer = window.setTimeout(() => go(current + 1), Math.max(remaining, 400));
    };
    const hold = (reason: string) => {
      if (holds.size === 0 && timer !== undefined) remaining -= Date.now() - started;
      holds.add(reason);
      tick();
    };
    const release = (reason: string) => {
      holds.delete(reason);
      tick();
    };
    const setUserPaused = (paused: boolean) => {
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Spustit prezentaci' : 'Pozastavit prezentaci');
      paused ? hold('user') : release('user');
    };

    const go = (n: number) => {
      const next = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === next;
        s.classList.toggle('is-active', active);
        active ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (active ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        if (active) s.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === next)));
      // restart the progress bar animation
      dots[next]?.querySelector('i')?.getAnimations?.().forEach((a) => { a.cancel(); a.play(); });
      slides[(next + 1) % slides.length].querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      current = next;
      remaining = DURATION;
      tick();
    };

    hero.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1));
    hero.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1));
    pauseBtn.addEventListener('click', () => setUserPaused(!holds.has('user')));
    if (reduced) setUserPaused(true);
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    // pause while the pointer is over the texts/buttons or the controls (not the whole photo)
    hero.querySelectorAll('.hero__content, .hero__controls').forEach((el) => {
      el.addEventListener('mouseenter', () => hold('hover'));
      el.addEventListener('mouseleave', () => release('hover'));
    });
    hero.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) hold('focus'); });
    hero.addEventListener('focusout', () => release('focus'));
    document.addEventListener('visibilitychange', () => (document.hidden ? hold('hidden') : release('hidden')));

    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    // Preload slide 2 after first paint
    window.addEventListener('load', () => slides[1]?.querySelectorAll('img').forEach((img) => (img.loading = 'eager')));
    tick();
  }
</script>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { folder } from '../lib/images';

const imgs = folder('hero');
const kitchens = folder('kuchyne');
const living = folder('obyvaci-pokoje');
// Texts and targets taken over from the original website; photos swapped for the sharpest modern realizations.
const slides = [
  { img: kitchens[173], kicker: 'Kuchyně na míru', title: 'Tvoříme kuchyně na míru vašim představám', link: ['Prohlédnout realizace', '/realizace/'] },
  { img: kitchens[41], kicker: 'Realizace', title: 'Kuchyně propracované do posledního detailu', link: ['Dokončené realizace', '/realizace/'] },
  { img: living[9], kicker: 'Obývací stěny na míru', title: 'Kuchyně i obývací stěny na míru', link: ['Prohlédnout realizace', '/realizace/#obyvaci-pokoje'] },
  { img: imgs[4], kicker: 'Akční nabídka', title: 'Vystavená kuchyň na prodej za akční cenu', link: ['Prohlédnout zblízka', '/kuchyn-na-prodej/'] },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero" data-hero aria-roledescription="carousel" aria-label="Představení">
  <div class="hero__slides">
    {slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : undefined}>
        <div class="hero__media">
          <Image src={s.img} alt="" widths={[768, 1280, 1920, 2560]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} priority={i === 0} quality={78} />
        </div>
        <div class="container hero__content">
          <p class="hero__kicker">{s.kicker}</p>
          {i === 0 ? <h1>{s.title}</h1> : <p class="hero__title">{s.title}</p>}
          <a class="hero__link" href={s.link[1]} tabindex={i === 0 ? undefined : -1}>{s.link[0]}</a>
        </div>
      </div>
    ))}
  </div>
  <div class="container hero__controls">
    <span class="hero__count" aria-hidden="true"><b data-count>01</b><i></i>{pad(slides.length)}</span>
    <div class="hero__dots" role="tablist" aria-label="Vybrat snímek">
      {slides.map((s, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Snímek ${i + 1}: ${s.title}`} data-dot={i}>
          <span class="hero__dot-bar"><i></i></span>
        </button>
      ))}
    </div>
    <button type="button" class="hero__pause" data-pause aria-pressed="false" aria-label="Pozastavit prezentaci"><Icon name="pause" size={14} class="i-pause" /><Icon name="play" size={14} class="i-play" /></button>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 580px; max-height: 1100px; color: #fff; background: var(--ink); overflow: hidden; }
  .hero__slides, .hero__slide { position: absolute; inset: 0; }
  .hero__slide { opacity: 0; visibility: hidden; transition: opacity 1.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 1.3s; display: flex; align-items: flex-end; justify-content: center; }
  .hero__slide.is-active { opacity: 1; visibility: visible; transition: opacity 1.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s; z-index: 1; }
  .hero__media { position: absolute; inset: 0; }
  /* slow cinematic push-in */
  .hero__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); transition: transform 6s cubic-bezier(0.25, 0.1, 0.25, 1); }
  .is-active .hero__media img { transform: scale(1.02); }
  /* modern black fade rising from the bottom (eased stops, no visible band) + a faint warm gold glow under the text;
     a light top shade keeps the transparent header readable. The photo stays the hero. */
  .hero__media::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 55% 32% at 50% 100%, rgba(193, 144, 49, 0.16) 0%, rgba(193, 144, 49, 0) 70%),
      linear-gradient(0deg, rgba(8, 7, 6, 0.86) 0%, rgba(8, 7, 6, 0.66) 16%, rgba(8, 7, 6, 0.4) 34%, rgba(8, 7, 6, 0.16) 52%, rgba(8, 7, 6, 0.04) 66%, rgba(8, 7, 6, 0) 78%),
      linear-gradient(180deg, rgba(8, 7, 6, 0.38) 0%, rgba(8, 7, 6, 0) 20%);
  }
  /* fine gold hairline closing the hero */
  .hero::after { content: ''; position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; height: 1px; background: var(--gold-line); opacity: 0.85; }
  .hero__content { position: relative; text-align: center; padding-bottom: clamp(6rem, 13vh, 8.5rem); text-shadow: 0 1px 18px rgba(0, 0, 0, 0.28); }
  .hero__kicker { display: inline-flex; align-items: center; gap: 0.9rem; margin: 0 0 1.1rem; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--gold-soft); }
  .hero__kicker::before, .hero__kicker::after { content: ''; width: 2.4rem; height: 1px; background: linear-gradient(90deg, rgba(227, 199, 143, 0), var(--gold-soft)); }
  .hero__kicker::after { transform: scaleX(-1); }
  .hero h1, .hero__title { font-size: clamp(2.1rem, 4.6vw, 4.1rem); font-weight: 300; line-height: 1.08; letter-spacing: -0.02em; max-width: 20ch; margin: 0 auto 1.6rem; text-wrap: balance; }
  .hero__link { display: inline-block; color: #fff; text-decoration: none; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; padding: 0.95rem 1.8rem; border: 1px solid rgba(227, 199, 143, 0.6); background: rgba(8, 7, 6, 0.18); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s, box-shadow 0.4s var(--ease); text-shadow: none; }
  .hero__link:hover { background: var(--gold-fill); color: #fff; border-color: var(--gold-fill); box-shadow: 0 14px 30px -14px rgba(193, 144, 49, 0.75); }
  .hero__content > * { opacity: 0; transform: translateY(16px); transition: opacity 1s var(--ease), transform 1s var(--ease); }
  .is-active .hero__content > * { opacity: 1; transform: none; }
  .is-active .hero__content > :nth-child(1) { transition-delay: 0.35s; }
  .is-active .hero__content > :nth-child(2) { transition-delay: 0.5s; }
  .is-active .hero__content > :nth-child(3) { transition-delay: 0.65s; }
  .hero__controls { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(1.6rem, 4.5vh, 2.6rem); display: flex; justify-content: center; align-items: center; gap: 1.2rem; }
  .hero__count { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; letter-spacing: 0.2em; color: rgba(255, 255, 255, 0.7); font-variant-numeric: tabular-nums; }
  .hero__count b { font-weight: 500; color: var(--gold-soft); }
  .hero__count i { width: 1.2rem; height: 1px; background: rgba(227, 199, 143, 0.55); }
  .hero__dots { display: flex; gap: 0.4rem; }
  .hero__dots button { background: none; border: 0; cursor: pointer; padding: 0.7rem 0; }
  .hero__dot-bar { display: block; width: clamp(26px, 3.2vw, 44px); height: 1px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .hero__dot-bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--gold-fill), var(--gold-soft)); transform: scaleX(0); transform-origin: left; }
  [aria-selected='true'] .hero__dot-bar i { animation: hero-progress var(--hero-duration, 7s) linear forwards; }
  .hero.is-paused [aria-selected='true'] .hero__dot-bar i { animation-play-state: paused; }
  @keyframes hero-progress { to { transform: scaleX(1); } }
  .hero__pause { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.4); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background 0.3s, color 0.3s; }
  .hero__pause:hover { background: var(--gold-fill); border-color: var(--gold-fill); color: #fff; }
  .hero__pause :global(.i-play), .hero__pause[aria-pressed='true'] :global(.i-pause) { display: none; }
  .hero__pause[aria-pressed='true'] :global(.i-play) { display: block; }
  @media (max-width: 760px) {
    .hero { height: 88svh; }
    .hero__content { padding-bottom: 5.5rem; }
    .hero__kicker { font-size: 0.68rem; letter-spacing: 0.26em; margin-bottom: 0.9rem; }
    .hero__kicker::before, .hero__kicker::after { width: 1.25rem; }
    .hero h1, .hero__title { font-size: clamp(1.85rem, 8vw, 2.4rem); margin-bottom: 1.3rem; }
    .hero__count { display: none; }
    .hero__media::after {
      background:
        radial-gradient(ellipse 90% 30% at 50% 100%, rgba(193, 144, 49, 0.14) 0%, rgba(193, 144, 49, 0) 70%),
        linear-gradient(0deg, rgba(8, 7, 6, 0.88) 0%, rgba(8, 7, 6, 0.7) 20%, rgba(8, 7, 6, 0.4) 40%, rgba(8, 7, 6, 0.12) 60%, rgba(8, 7, 6, 0) 76%),
        linear-gradient(180deg, rgba(8, 7, 6, 0.36) 0%, rgba(8, 7, 6, 0) 20%);
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const DURATION = 4500;
    hero.style.setProperty('--hero-duration', `${DURATION}ms`);
    let current = 0;
    let timer: number | undefined;
    let remaining = DURATION;
    let started = 0;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]')!;
    // Autoplay runs only when nothing holds it: user pause, mouse over, keyboard focus, hidden tab
    const holds = new Set<string>(reduced ? ['user'] : []);

    const tick = () => {
      clearTimeout(timer);
      hero.classList.toggle('is-paused', holds.size > 0);
      if (holds.size > 0) return;
      started = Date.now();
      timer = window.setTimeout(() => go(current + 1), Math.max(remaining, 400));
    };
    const hold = (reason: string) => {
      if (holds.size === 0 && timer !== undefined) remaining -= Date.now() - started;
      holds.add(reason);
      tick();
    };
    const release = (reason: string) => {
      holds.delete(reason);
      tick();
    };
    const setUserPaused = (paused: boolean) => {
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Spustit prezentaci' : 'Pozastavit prezentaci');
      paused ? hold('user') : release('user');
    };

    const go = (n: number) => {
      const next = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === next;
        s.classList.toggle('is-active', active);
        active ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (active ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        if (active) s.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === next)));
      const count = hero.querySelector('[data-count]');
      if (count) count.textContent = String(next + 1).padStart(2, '0');
      // restart the progress bar animation
      dots[next]?.querySelector('i')?.getAnimations?.().forEach((a) => { a.cancel(); a.play(); });
      slides[(next + 1) % slides.length].querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      current = next;
      remaining = DURATION;
      tick();
    };

    hero.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1));
    hero.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1));
    pauseBtn.addEventListener('click', () => setUserPaused(!holds.has('user')));
    if (reduced) setUserPaused(true);
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    // pause while the pointer is over the texts/buttons or the controls (not the whole photo)
    hero.querySelectorAll('.hero__content, .hero__controls').forEach((el) => {
      el.addEventListener('mouseenter', () => hold('hover'));
      el.addEventListener('mouseleave', () => release('hover'));
    });
    hero.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) hold('focus'); });
    hero.addEventListener('focusout', () => release('focus'));
    document.addEventListener('visibilitychange', () => (document.hidden ? hold('hidden') : release('hidden')));

    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    // Preload slide 2 after first paint
    window.addEventListener('load', () => slides[1]?.querySelectorAll('img').forEach((img) => (img.loading = 'eager')));
    tick();
  }
</script>

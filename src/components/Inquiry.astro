---
import { Image } from 'astro:assets';
import InquiryForm from './InquiryForm.astro';
import Icon from './Icon.astro';
import mm from '../assets/img/brand/mm-spotrebice.png';
import { site } from '../data/site';
---
<section class="section inquiry" id="poptavka">
  <div class="container inquiry__grid">
    <div class="inquiry__intro">
      <p class="eyebrow" data-reveal>Nezávazná poptávka</p>
      <h2 data-reveal>Nezávazná poptávka včetně kompletního návrhu</h2>
      <p class="lead" data-reveal>Sdělte nám vaši představu realizace, nebo nám rovnou zavolejte.</p>
      <ul class="inquiry__contacts" data-reveal>
        <li><a href={site.phoneHref}><span class="inquiry__icon"><Icon name="phone" /></span><span><small>Zavolejte nám</small>{site.phone}</span></a></li>
        <li><a href={`mailto:${site.email}`}><span class="inquiry__icon"><Icon name="mail" /></span><span><small>Napište nám</small>{site.email}</span></a></li>
      </ul>
      <a class="partner" href={site.partner.url} target="_blank" rel="noopener" data-reveal>
        <Image src={mm} alt={site.partner.name} width={229} height={60} />
        <small>Spotřebiče do kuchyní v té nejvyšší kvalitě dodává česká rodinná firma</small>
      </a>
    </div>
    <div class="inquiry__card" data-reveal>
      <InquiryForm />
    </div>
  </div>
</section>

<style>
  .inquiry { background: var(--cream); }
  .inquiry__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .inquiry__intro { padding-top: 0.5rem; }
  .inquiry__contacts { list-style: none; padding: 0; display: grid; gap: 1.1rem; margin: 2.2rem 0; }
  .inquiry__contacts a { display: flex; gap: 1rem; align-items: center; text-decoration: none; font-size: 1.1rem; font-weight: 500; color: var(--ink); }
  .inquiry__icon { width: 50px; height: 50px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #fff; border: 1px solid var(--line); color: var(--gold-dark); transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .inquiry__contacts a:hover .inquiry__icon { background: var(--gold); color: #fff; border-color: var(--gold); }
  .inquiry__contacts small { display: block; font-size: 0.72rem; font-weight: 500; color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.4; }
  .partner { display: flex; align-items: center; gap: 1.2rem; padding-top: 2rem; border-top: 1px solid var(--line); text-decoration: none; color: var(--muted); }
  .partner img { height: 42px; width: auto; flex: none; }
  .partner small { font-size: 0.82rem; line-height: 1.5; max-width: 28ch; }
  .inquiry__card { background: #fff; border-radius: var(--radius-lg); padding: clamp(1.5rem, 4vw, 2.75rem); box-shadow: 0 30px 60px -35px rgba(21, 18, 14, 0.35); }
  @media (max-width: 900px) { .inquiry__grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .partner { flex-direction: column; align-items: flex-start; } }
</style>

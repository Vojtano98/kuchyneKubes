---
import Icon from './Icon.astro';
import { reviews, reviewsSource } from '../data/reviews';
---
<section class="section reviews" id="recenze">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Reference</p>
        <h2 data-reveal>Co o nás říkají zákazníci</h2>
      </div>
      <p class="lead" data-reveal>Nejlepší reklamou jsou nám spokojení zákazníci. Hodnocení z veřejného profilu na {reviewsSource.name}.</p>
    </div>
    <div class="reviews__grid">
      {reviews.map((r, i) => (
        <figure class="review" data-reveal style={`--delay:${i * 0.1}s`}>
          <div class="review__stars" role="img" aria-label="Hodnocení 5 z 5">{Array.from({ length: 5 }, () => <span aria-hidden="true">★</span>)}</div>
          <blockquote><p>„{r.text}“</p></blockquote>
          <figcaption>
            <strong>{r.author}</strong>
            <span>{r.topic} · {reviewsSource.name}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <a class="link-arrow reviews__more" href={reviewsSource.url} target="_blank" rel="noopener" data-reveal>Všechna hodnocení na {reviewsSource.name} <Icon name="arrow" size={16} /></a>
  </div>
</section>

<style>
  .reviews { background: var(--paper); }
  .reviews__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); }
  .review { position: relative; margin: 0; padding: clamp(1.6rem, 3vw, 2.4rem); background: var(--cream); border-radius: var(--radius-lg); display: flex; flex-direction: column; overflow: hidden; }
  .review::before { content: '“'; position: absolute; right: 1.25rem; top: -1.1rem; font-size: 8rem; line-height: 1; font-weight: 300; color: var(--gold-brand); opacity: 0.18; pointer-events: none; }
  .review__stars { display: flex; gap: 0.2rem; color: var(--gold-brand); font-size: 1rem; letter-spacing: 0; margin-bottom: 1rem; }
  .review blockquote { margin: 0 0 1.5rem; flex: 1; }
  .review blockquote p { margin: 0; font-size: clamp(1.05rem, 1.5vw, 1.2rem); font-weight: 300; line-height: 1.65; color: var(--ink); }
  .review figcaption { display: flex; flex-direction: column; gap: 0.15rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .review figcaption strong { color: var(--ink); font-weight: 500; }
  .review figcaption span { font-size: 0.85rem; color: var(--muted); }
  .reviews__more { margin-top: clamp(1.25rem, 3vw, 2rem); }
  /* Phones: cards side by side, swipe sideways (the next card peeks in) */
  @media (max-width: 760px) {
    .reviews__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 86%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .reviews__grid::-webkit-scrollbar { display: none; }
    .review { scroll-snap-align: start; padding: 1.4rem; }
    .review blockquote { margin-bottom: 1.1rem; }
    .review blockquote p { font-size: 1rem; line-height: 1.6; }
  }
</style>

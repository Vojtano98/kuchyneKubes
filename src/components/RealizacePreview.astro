---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';

// Hand-picked photos (category, index in its folder) – the strongest shots across categories
const picks: [string, number, string][] = [
  ['kuchyne', 204, 'big'],
  ['obyvaci-pokoje', 8, ''],
  ['loznice', 10, ''],
  ['chodby', 15, ''],
  ['koupelny', 6, ''],
  ['kuchyne', 217, 'wide'],
  ['detske-pokoje', 25, ''],
  ['kuchyne', 190, ''],
];
const name = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
const items = picks.map(([slug, i, size]) => ({ slug, size, img: folder(slug)[i] ?? folder(slug)[0], label: name(slug) }));
const total = Math.floor(categories.filter((c) => c.service).reduce((n, c) => n + folder(c.slug).length, 0) / 50) * 50;
---
<section class="section realizace" id="realizace">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Realizace</p>
        <h2 data-reveal>Vybrané realizace u zákazníků</h2>
      </div>
      <p class="lead" data-reveal>Více než {total} fotografií hotových kuchyní a nábytku na míru přímo u našich zákazníků.</p>
    </div>

    <ul class="mosaic">
      {items.map((it, i) => (
        <li class:list={['mosaic__item', it.size && `mosaic__item--${it.size}`]} data-reveal style={`--delay:${(i % 4) * 0.06}s`}>
          <a href={`/realizace/#${it.slug}`}>
            <Image src={it.img} alt={`${it.label} na míru – realizace`} widths={[400, 700, 1100]} sizes={it.size === 'big' ? '(max-width: 700px) 92vw, 620px' : it.size === 'wide' ? '(max-width: 700px) 92vw, 620px' : '(max-width: 700px) 46vw, 300px'} />
            <span class="mosaic__label">{it.label} <Icon name="arrow" size={15} /></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="realizace__cta" data-reveal>
      <a class="btn btn--dark" href="/realizace/">Zobrazit celou galerii <Icon name="arrow" /></a>
      <a class="btn btn--outline" href="#poptavka">Nezávazná poptávka</a>
    </div>
  </div>
</section>

<style>
  .mosaic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(170px, 17vw, 250px); gap: clamp(0.6rem, 1.2vw, 1rem); }
  .mosaic__item--big { grid-column: span 2; grid-row: span 2; }
  .mosaic__item--wide { grid-column: span 2; }
  .mosaic a { position: relative; display: block; height: 100%; border-radius: var(--radius); overflow: hidden; background: var(--sand); color: #fff; text-decoration: none; isolation: isolate; transform: translateZ(0); }
  .mosaic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: transform 1.2s var(--ease); }
  .mosaic a::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; background: linear-gradient(0deg, rgba(8, 7, 6, 0.66) 0%, rgba(8, 7, 6, 0.28) 28%, rgba(8, 7, 6, 0) 52%); box-shadow: inset 0 0 0 1px rgba(227, 199, 143, 0); transition: box-shadow 0.5s var(--ease); }
  .mosaic a:hover::after { box-shadow: inset 0 0 0 1px rgba(227, 199, 143, 0.85); }
  .mosaic a:hover img { transform: scale(1.05); }
  .mosaic__label { position: absolute; z-index: 2; left: clamp(0.8rem, 1.5vw, 1.1rem); bottom: clamp(0.7rem, 1.4vw, 1rem); display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.92rem; font-weight: 500; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3); }
  .mosaic__label :global(svg) { color: var(--gold-soft); transition: transform 0.4s var(--ease); }
  .mosaic a:hover .mosaic__label :global(svg) { transform: translateX(3px); }
  .mosaic__item--big .mosaic__label { font-size: 1.15rem; }
  .realizace__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin-top: clamp(2rem, 4vw, 3rem); }
  @media (max-width: 700px) {
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 150px; }
    .mosaic__item--big { grid-row: span 2; }
  }
</style>

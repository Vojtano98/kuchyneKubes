---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';

// Cover photo per category (index into the category folder)
const coverIndex: Record<string, number> = { kuchyne: 33 };
const cards = categories
  .filter((c) => c.service)
  .map((c) => {
    const imgs = folder(c.slug);
    return { ...c, count: imgs.length, cover: imgs[coverIndex[c.slug] ?? 0] ?? imgs[0] };
  });
const total = Math.floor(cards.reduce((n, c) => n + c.count, 0) / 50) * 50;
---
<section class="section realizace" id="realizace">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Realizace</p>
        <h2 data-reveal>Hotové realizace u zákazníků</h2>
      </div>
      <p class="lead" data-reveal>Více než {total} fotografií hotových kuchyní a nábytku na míru přímo u našich zákazníků.</p>
    </div>

    <ul class="realizace__grid">
      {cards.map((c, i) => (
        <li data-reveal style={`--delay:${(i % 3) * 0.08}s`}>
          <a class="card" href={`/realizace/#${c.slug}`}>
            <div class="card__img">
              <Image src={c.cover} alt={`${c.name} – nábytek na míru`} widths={[400, 640, 900]} sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 380px" />
            </div>
            <div class="card__body">
              <div>
                <h3>{c.name}</h3>
                <span class="card__count">{c.count} fotografií</span>
              </div>
              <span class="card__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="realizace__cta" data-reveal>
      <a class="btn btn--dark" href="/realizace/">Zobrazit všechny realizace <Icon name="arrow" /></a>
      <a class="btn btn--outline" href="#poptavka">Nezávazná poptávka</a>
    </div>
  </div>
</section>

<style>
  .realizace__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.5vw, 3rem) clamp(1rem, 2vw, 1.75rem); }
  .card { display: block; text-decoration: none; color: var(--ink); }
  .card__img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; background: var(--sand); }
  .card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .card:hover .card__img img { transform: scale(1.05); }
  .card__body { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0.2rem 0; }
  .card h3 { margin: 0; font-size: clamp(1.2rem, 1.8vw, 1.45rem); }
  .card__count { font-size: 0.88rem; color: var(--muted); }
  .card__arrow { width: 44px; height: 44px; flex: none; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; color: var(--ink); transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.4s var(--ease); }
  .card:hover .card__arrow { background: var(--gold); border-color: var(--gold); color: #fff; transform: translateX(3px); }
  .realizace__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin-top: clamp(3rem, 6vw, 4.5rem); }
  @media (max-width: 1000px) { .realizace__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .realizace__grid { grid-template-columns: 1fr; } }
</style>

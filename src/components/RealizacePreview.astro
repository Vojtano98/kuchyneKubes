---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categories } from '../data/categories';
import { folder } from '../lib/images';

// Cover photo per category (index into the category folder)
const coverIndex: Record<string, number> = { kuchyne: 33 };
const cards = categories
  .filter((c) => c.service)
  .map((c) => {
    const imgs = folder(c.slug);
    return { ...c, count: imgs.length, cover: imgs[coverIndex[c.slug] ?? 0] ?? imgs[0] };
  });
const total = Math.floor(cards.reduce((n, c) => n + c.count, 0) / 50) * 50;
---
<section class="section realizace" id="realizace">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Realizace</p>
        <h2 data-reveal>Hotové realizace u zákazníků</h2>
      </div>
      <p class="lead" data-reveal>Více než {total} fotografií hotových kuchyní a nábytku na míru přímo u našich zákazníků.</p>
    </div>

    <ul class="realizace__grid">
      {cards.map((c, i) => (
        <li data-reveal style={`--delay:${(i % 3) * 0.08}s`}>
          <a class="card" href={`/realizace/#${c.slug}`}>
            <Image src={c.cover} alt={`${c.name} – nábytek na míru`} widths={[400, 640, 900]} sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 380px" />
            <div class="card__body">
              <div>
                <h3>{c.name}</h3>
                <span class="card__count">{c.count} fotografií</span>
              </div>
              <span class="card__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="realizace__cta" data-reveal>
      <a class="btn btn--dark" href="/realizace/">Zobrazit všechny realizace <Icon name="arrow" /></a>
      <a class="btn btn--outline" href="#poptavka">Nezávazná poptávka</a>
    </div>
  </div>
</section>

<style>
  .realizace__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .card { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; text-decoration: none; color: #fff; background: var(--sand); isolation: isolate; transform: translateZ(0); }
  .card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: transform 1.2s var(--ease); }
  /* subtle dark strip at the bottom, just enough to read the text */
  .card::after { content: ''; position: absolute; inset: auto 0 0; height: 48%; z-index: 1; background: linear-gradient(0deg, rgba(15, 12, 9, 0.52) 0%, rgba(15, 12, 9, 0.22) 50%, rgba(15, 12, 9, 0) 100%); }
  .card:hover img { transform: scale(1.05); }
  .card__body { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; z-index: 2; padding: clamp(1rem, 2vw, 1.35rem); text-shadow: 0 1px 6px rgba(0, 0, 0, 0.28); }
  .card h3 { margin: 0; font-size: clamp(1.2rem, 1.8vw, 1.45rem); color: #fff; }
  .card__count { font-size: 0.85rem; opacity: 0.9; }
  .card__arrow { width: 42px; height: 42px; flex: none; border-radius: 50%; display: grid; place-items: center; color: #fff; background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: background 0.3s, border-color 0.3s, transform 0.4s var(--ease); }
  .card:hover .card__arrow { background: var(--gold); border-color: var(--gold); transform: translateX(3px); }
  .realizace__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin-top: clamp(2rem, 4vw, 3rem); }
  @media (max-width: 1000px) { .realizace__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .realizace__grid { grid-template-columns: 1fr; } }
</style>
